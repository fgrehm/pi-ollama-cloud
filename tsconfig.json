{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "config.ts",
    "models.ts",
    "thinking-levels.ts",
    "usage.ts",
    "utils.ts",
    "web-tools.ts",
    "test/*.ts"
  ]
}
